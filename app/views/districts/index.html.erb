<p style="color: green"><%= notice %></p>

<% content_for :title, "Districts" %>

<h1>Districts</h1>

<div id="districts">
  <% @districts.each do |district| %>
    <%= render district %>
    <p>
      <%= link_to "Show this district", district %>
    </p>
  <% end %>
</div>

<%= link_to "New district", new_district_path %>
