<%= form_with(model: winery) do |form| %>
  <% if winery.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(winery.errors.count, "error") %> prohibited this winery from being saved:</h2>

      <ul>
        <% winery.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :website, style: "display: block" %>
    <%= form.text_field :website %>
  </div>

  <div>
    <%= form.label :address, style: "display: block" %>
    <%= form.text_field :address %>
  </div>

  <%= form.grouped_collection_select :district_id,
          @departments,                 # collection of groups
          :districts,                   # method that returns the options for each group
          :name,                        # method to display as group label
          :id,                          # value method for the option
          :name,                        # text method for the option
          { include_blank: "Select a district..." },
          { class: "form-select" } %>

  <div>
    <%= form.submit %>
  </div>
<% end %>
