<div id="<%= dom_id product %>">
  <div>
    <strong>Title:</strong>
    <%= product.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= product.description %>
  </div>

  <div>
    <strong>Image:</strong>
    <%= link_to product.image.filename, product.image if product.image.attached? %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= product.price %>
  </div>

</div>
