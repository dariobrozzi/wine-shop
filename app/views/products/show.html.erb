<p style="color: green"><%= notice %></p>

<div id="<%= dom_id @product %>">
  <% if @product.image %>
    <div>
        <%= image_tag(@product.image, alt: @product.title, height: '450px') if @product.image.present? %>
    </div>
  <% end %>
  <div>
    <div>
      <strong>Title:</strong>
      <%= @product.title %>
    </div>

    <div>
      <strong>Description:</strong>
      <%= @product.description %>
    </div>

    <div>
      <strong>Price:</strong>
      <%= @product.price %>
    </div>
  </div>
</div>

<div>
  <%= link_to "Edit this product", edit_product_path(@product) %> |
  <%= link_to "Back to products", products_path %>

  <%= button_to "Destroy this product", @product, method: :delete %>
</div>
