<p style="color: green"><%= notice %></p>

<% content_for :title, "Departments" %>

<h1>Departments</h1>

<table id="departments">
    <thead>
        <th>
            Name
        </th>
        <th>
            Actions
        </th>
    </thead>
    <tbody>
  <% @departments.each do |department| %>
      <tr>
          <td>
              <%= department.name %>
          </td>
          <td>
              <%= link_to "Show", department %>
          </td>
      </tr>
  <% end %>
    </tbody>
</table>

<%= link_to "New department", new_department_path %>
